{
  "manifest_version": 3,
  "name": "酸橙 · 本地密码填写",
  "version": "0.1.1",
  "description": "从本机酸橙收藏室选择当前网站的账号并填写。",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "酸橙密码"
  },
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "打开酸橙并选择当前网站账号"
    }
  }
}
