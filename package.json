{
  "name": "until-a-lime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "test": "vitest run && node --experimental-strip-types --test scripts/generator.test.mjs scripts/entry-actions.test.mjs scripts/preferences.test.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" vitest.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  }
}
